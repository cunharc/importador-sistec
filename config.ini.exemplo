; CNPJ da empresa que emitiu os XMLs — é ele que separa nota própria de terceiros.
; O cadastro da filial no ERP tem a palavra final sobre este valor.
cnpj_empresa =
empresa = 1
filial = 1
gerar_financeiro = S
; NAT_FLUXO_CAIXA e NAT_CONTABILIDADE das naturezas usadas na importação. Com fluxo
; de caixa em S, o faturamento do ERP (CONFAT) gera o título ao passar pela nota —
; para cliente cujo financeiro veio por planilha, deixe N.
nat_fluxo_caixa = S
nat_contabilidade = S
local_cobranca =
vendedor_padrao =
; Só saídas | Só entradas | Saídas + Entradas — cada escopo tem o seu rateio
escopo = Só saídas
centro_custo_saida = (nenhum)
conta_contabil_saida = (nenhuma)
centro_custo_entrada = (nenhum)
conta_contabil_entrada = (nenhuma)
; Cliente | Fornecedor | Cliente e Fornecedor | Outros | Automático (pela nota)
tipo_cadastro_cf = Automático (pela nota)

[ATUALIZACAO]
; Versão que o usuário mandou não avisar mais (o botão "Não avisar desta versão").
; A versão seguinte volta a avisar.
versao_ignorada =
