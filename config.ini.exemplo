; Modelo do config.ini. Copie este arquivo para "config.ini" e ajuste.
;
; O config.ini de verdade NÃO vai para o repositório (está no .gitignore): ele guarda
; o caminho do banco do cliente, caminhos de rede internos, CNPJ e o último arquivo
; aberto em cada tela. Este modelo existe para que um clone novo saiba quais chaves
; existem sem publicar nada disso.
;
; As telas gravam as próprias preferências aqui sozinhas (último arquivo, aba, mapa de
; colunas, centro de custo...), então não é preciso preencher tudo à mão: o mínimo é a
; seção [FIREBIRD]. Se o config.ini não existir, o sistema cria um a partir deste
; modelo na primeira execução.

[FIREBIRD]
; Caminho do .FDB como o servidor Firebird o vê (barras normais funcionam no Windows)
caminho_banco = C:/CAMINHO/DO/BANCO.FDB
usuario = SYSDBA
senha = masterkey
; A DLL cliente fica ao lado do executável; o nome muda com a versão do Firebird
fbclient = fbclient_5.dll
servidor = localhost
; 3050 é o padrão do Firebird; instalações do ERP costumam usar 3052
porta = 3050

[IMPORTACAO]
empresa = 1
filial = 1
exercicio = 2026
coluna_conta = a
coluna_descricao = b
linha_inicial = 2
nivel_sintetico = 4
arquivo_excel =
aba_excel =
limpar_banco = False
uf =

[NFE]
empresa = 1
filial = 1

; --- As seções abaixo são preenchidas pelas telas conforme o uso. -------------
; map_* / mapa_* são LETRAS de coluna da planilha (A, B, ..., AX). Vazio = a tela
; ignora aquele campo.

